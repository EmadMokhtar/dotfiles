# Bootstrap copies this file to ~/.config/secrets/secrets.map when that file
# does not exist. The copy is NOT tracked in git. Edit the copy, not this file.
#
# <NAME>   <source>
#   keychain        value typed with `secret set NAME`, kept in the login keychain
#   op://V/I/F      1Password reference (vault / item / field), read with `op read`
#   cmd:<command>   value is the output of the command
#
# app <App name>   <NAME>[,<NAME>...]
#   `secret open "<App name>"` starts the app with these secrets.
#
# Run `secret list` to check this file. It never prints values.

GITHUB_PERSONAL_ACCESS_TOKEN   cmd:gh auth token
# The Claude desktop app signs in with its own account and drops
# CLAUDE_CODE_OAUTH_TOKEN, so it gets only the GitHub token.
# Quit the app, then start it with `secret open Claude`.
app Claude                     GITHUB_PERSONAL_ACCESS_TOKEN

# Store each value with `secret set NAME`.
CLAUDE_CODE_OAUTH_TOKEN        keychain
ANTHROPIC_API_KEY              keychain
OPENAI_API_KEY                 keychain

# Examples (fake names):
# EXAMPLE_API_KEY              op://Personal/Example/credential
# EXAMPLE_TOKEN                keychain
# app Example App              EXAMPLE_API_KEY,EXAMPLE_TOKEN
